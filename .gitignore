# Rebuilt, never committed: ./build.sh fetches SQLBI's public parquet release and builds the warehouse.
*.parquet
*.7z
*.duckdb
*.duckdb.wal
artifacts/estate/*.duckdb
artifacts/estate/*.sqlite
# The compiler's persisted finding set is regenerated on every compile.
compile.json
connection.local.yaml
.ontology-unlocked
__pycache__/
.DS_Store
